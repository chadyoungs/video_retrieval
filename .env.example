# Copy to .env and edit. Every setting below maps to config/settings.py.

# ---- device / model cache ----
DEVICE=auto                  # auto | cpu | cuda | cuda:0
MODEL_CACHE_DIR=./models
HF_ENDPOINT=https://hf-mirror.com
HF_LOCAL_ONLY=false          # true = never download, fail if weights missing

# ---- Milvus ----
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_ALIAS=video_retrieval
MILVUS_METRIC_TYPE=COSINE

# ---- PostgreSQL ----
PG_DSN=postgresql://devuser:pass123@127.0.0.1:5432/postgres

# ---- dataset selection ----
DATASET_SOURCE=activitynet
ACTIVITYNET_DATA_ROOT=/mnt/sdc/activitynet_caption/demo_data
ACTIVITYNET_FILE_FORMAT=mp4

NUSCENES_RAW_DATAROOT=/mnt/sdb/datasets/nuscenes-data/nuscenes
NUSCENES_VIDEO_ROOT=/mnt/sdb/datasets/nuscenes-data/nuscenes/samples/CAM_FRONT
NUSCENES_META_ROOT=/mnt/sdb/datasets/nuscenes-data/nuscenes/v1.0-mini
NUSCENES_CLIP_MAPPING_FILE=./datasets/builders/clip_mapping.json
NUSCENES_DATASET_VERSION=v1.0-mini
NUSCENES_DATASET_SPLIT=train
NUSCENES_CAMERA_CHANNEL=CAM_FRONT

# ---- encoder / slicing ----
ENCODER_TYPE=keyframes       # keyframes | whole_clip
KEYFRAME_COUNT=5
SEMANTIC_MODEL_TIER=base     # base (CLIP 512) | advanced (SigLIP 1152)
FRAME_SAMPLING_RATE=10
CLIP_DURATION_SEC=10
CLIP_OVERLAP_SEC=2
BATCH_SIZE_DB=5

# ---- annotator (Ollama VLM) ----
ANNOTATION_ENABLE=true
OLLAMA_HOST=http://localhost:11434
OLLAMA_API_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT=600
N_VLM_FRAMES=4

# ---- annotation quality flag ----
QUALITY_FLAG_OK=ok
QUALITY_FLAG_BAD=bad           # e.g. not_ok; must differ from QUALITY_FLAG_OK
QUALITY_STRICT_UNKNOWN=true    # any enum field resolving to unknown => bad
QUALITY_UNKNOWN_IGNORE_FIELDS= # csv, e.g. time_of_day,lighting

# ---- hybrid recall ----
WEIGHT_VECTOR=0.7
WEIGHT_METADATA=0.3
RECALL_POOL_MULTIPLIER=2

# ---- rerank ----
RERANKER_TOP_K=10
RERANKER_SCORE_THRESHOLD=0.0
RERANKER_WEIGHT_RULE=0.4
RERANKER_WEIGHT_CROSS_ENCODER=0.3
RERANKER_WEIGHT_VLM=0.3
RERANKER_ENABLE_CROSS_ENCODER=true
RERANKER_ENABLE_VLM=true
CROSS_ENCODER_MODEL_NAME=BAAI/bge-reranker-base
OLLAMA_RERANK_MODEL=qwen3-vl:8b
